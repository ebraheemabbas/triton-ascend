// RUN: bishengir-opt %S/Inputs/half-p-stream-source252.mlir --hivm-cvp-attention-p-stream="allow-sum-reassociation=true require-match=true" | FileCheck %s
// RUN: bishengir-opt %S/Inputs/half-p-stream-source252.mlir --pass-pipeline='builtin.module(hivm-cvp-attention-p-stream{allow-sum-reassociation=true require-match=true},hivm-cvp-attention-p-stream{allow-sum-reassociation=true})' | FileCheck %s
// RUN: %python %S/Inputs/half-p-stream-negative.py bishengir-opt %S/Inputs/half-p-stream-source252.mlir

// The actual pre-local producer/caller are generated by the original kernel.
// No saved image from this fixture is launched or used for a hardware timing.
// CHECK: hivm.cvp_attention.half_p_streams = 1 : i64
// CHECK: func.func @{{.*}}_cvp_half0
// CHECK-SAME: hivm.cvp_attention.half_p_phase = 0 : i64
// CHECK: func.func @{{.*}}_cvp_half1
// CHECK-SAME: hivm.cvp_attention.half_p_phase = 1 : i64
// CHECK: memref.alloc() : memref<8x65x16x1xf16
// CHECK: func.call @{{.*}}_cvp_half0
// CHECK: [0, 0, 0, 0] [4, 4, 16, 16]
// CHECK: [0, 8, 0, 0] [4, 4, 16, 16]
// CHECK: func.call @{{.*}}_cvp_half1
// CHECK: [0, 4, 0, 0] [4, 4, 16, 16]
// CHECK: [0, 12, 0, 0] [4, 4, 16, 16]
